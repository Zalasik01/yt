# ---------- Servidor ----------
PORT=3333
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3333   # usado no redirect do OAuth do YouTube
WEB_APP_URL=http://localhost:5173
# Proteja a API quando expor na internet (o painel envia em x-api-key)
API_KEY=

# ---------- Supabase ----------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# supabase = arquivos no Storage (vários workers/máquinas) | local = disco (uma máquina só)
STORAGE_DRIVER=supabase

# ---------- IA: texto (pauta, roteiro, cenas, shorts, thumbnail) ----------
# anthropic | demo (demo = respostas de exemplo, sem custo, para testar a fábrica)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_FALLBACKS=true

# ---------- IA: voz e imagem (configurado por canal no painel) ----------
# Voz "edge" é gratuita e não precisa de chave.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=
PEXELS_API_KEY=

# ---------- YouTube (Google Cloud > APIs > YouTube Data API v3 > OAuth Web) ----------
# Redirect URI autorizado: {PUBLIC_API_URL}/api/v1/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------- Worker / render ----------
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=3000
WORK_DIR=./.work
BACKGROUND_MUSIC_DIR=          # pasta com .mp3 sem direitos autorais (opcional)
BACKGROUND_MUSIC_VOLUME=0.12
SUBTITLE_FONT=DejaVu Sans
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
