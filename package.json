{
  "name": "canal-dark-factory",
  "private": true,
  "version": "0.1.0",
  "description": "Fábrica de canal dark no YouTube movida a IA: pauta, roteiro, narração, cenas, montagem, shorts, thumbnail e agenda.",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:worker": "npm run dev:worker --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
